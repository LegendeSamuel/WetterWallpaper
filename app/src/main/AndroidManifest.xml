<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <!-- grober Standort reicht für Sonnen- und Mondstand -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Wetter von Open-Meteo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Widget „Nächster Termin“, nur nach Freigabe -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".WetterApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Wetter Wallpaper"
        android:largeHeap="true"
        android:theme="@style/Theme.Wetter">

        <!-- Vorschau + Einstellungen; nimmt auch "Teilen → Wetter Wallpaper" an -->
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Teilen → Wetter Wallpaper" aus der Galerie -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity android:name=".CropActivity" android:exported="false" />

        <!-- Favoriten als .zip teilen -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service android:name=".WeatherWallpaperService" android:exported="true"
            android:label="Wetter Wallpaper"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
